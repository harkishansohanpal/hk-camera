{
  "name": "hk-camera-backend",
  "version": "1.0.0",
  "description": "HK Camera – Backend API & WebRTC Signaling Server",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node src/prisma/seed.js",
    "db:studio": "prisma studio",
    "lint": "eslint src/ --ext .js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage",
    "test:regression": "jest --runInBand --forceExit --testPathPattern='regression|health|auth|cameras|turn'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@prisma/client": "^5.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "onnxruntime-node": "^1.26.0",
    "redis": "^4.6.13",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.4",
    "stripe": "^22.1.1",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.11.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  }
}
