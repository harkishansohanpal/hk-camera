generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────
model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  name             String
  avatarUrl        String?
  role             Role           @default(USER)
  isDemo           Boolean        @default(false)
  pushSubscription String?        // JSON string of PushSubscription
  emailAlerts      Boolean        @default(true)
  pushAlerts       Boolean        @default(true)
  stripeCustomerId String?        @unique
  subscription     Subscription?
  refreshTokens    RefreshToken[]
  cameras          Camera[]
  alerts           Alert[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum Role {
  USER
  ADMIN
}

// ── RefreshToken ──────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Camera ────────────────────────────────────────────────────
model Camera {
  id             String         @id @default(uuid())
  name           String
  description    String?
  streamKey      String         @unique @default(uuid())
  isOnline       Boolean        @default(false)
  motionDetect   Boolean        @default(true)
  sensitivity    Int            @default(30)   // 1-100 (pixel-diff)
  detectionMode  DetectionMode  @default(PIXEL_DIFF)
  mlConfidence   Int            @default(50)   // 0-100 (ML confidence threshold)
  nightVision    Boolean        @default(false)
  twoWayAudio    Boolean        @default(true)
  recordOnMotion Boolean        @default(false)
  exposure       Int            @default(0)      // EV compensation: -3 to 3
  focus          Int            @default(50)     // Manual focus: 0-100
  whiteBalance   String         @default("auto") // auto, daylight, cloudy, tungsten, fluorescent
  iso            Int            @default(100)    // 100-3200
  brightness     Int            @default(50)     // 0-100
  contrast       Int            @default(50)     // 0-100
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordings     Recording[]
  alerts         Alert[]
  lastSeen       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum DetectionMode {
  PIXEL_DIFF
  ML
}

// ── Recording ─────────────────────────────────────────────────
model Recording {
  id         String          @id @default(uuid())
  filename   String
  url        String
  size       Int             // bytes
  duration   Int?            // seconds
  trigger    RecordingTrigger @default(MANUAL)
  cameraId   String
  camera     Camera          @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  thumbnailUrl String?
  createdAt  DateTime        @default(now())
}

enum RecordingTrigger {
  MANUAL
  MOTION
  SCHEDULED
}

// ── Alert ─────────────────────────────────────────────────────
model Alert {
  id         String      @id @default(uuid())
  type       AlertType
  message    String
  thumbnailUrl String?
  read       Boolean     @default(false)
  cameraId   String
  camera     Camera      @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
}

enum AlertType {
  MOTION
  CAMERA_OFFLINE
  CAMERA_ONLINE
  RECORDING_COMPLETE
}

// ── Plan (Stripe) ─────────────────────────────────────────────
model Plan {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Int            // cents
  currency      String         @default("usd")
  interval      PlanInterval   @default(MONTHLY)
  features      String         // JSON array
  highlighted   Boolean        @default(false)
  stripePriceId String         @unique
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

// ── Subscription (Stripe) ─────────────────────────────────────
model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

// ── Log ────────────────────────────────────────────────────────
model Log {
  id        String   @id @default(uuid())
  level     String   // debug, info, warn, error
  tag       String   // WebRTC, Viewer, CameraView, Signaling, etc.
  message   String
  meta      Json?
  sessionId String?
  userId    String?
  cameraId  String?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([tag, createdAt])
  @@index([userId])
  @@index([cameraId])
  @@index([createdAt])
}
