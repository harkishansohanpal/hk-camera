NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://hk:secret@localhost:5432/hkdb
REDIS_URL=redis://localhost:6379

JWT_SECRET=supersecretjwtkey_changeme
JWT_REFRESH_SECRET=supersecretrefreshkey_changeme
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=hk-camera-recordings

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=noreply@hkcamera.app

# ── Seed / Demo Account ────────────────────────────────────────────
# Admin user (required for seeding):
ADMIN_EMAIL=admin@hkcamera.app
ADMIN_PASSWORD=
# Demo account (set SEED_DEMO=true to create during seeding):
SEED_DEMO=true
DEMO_EMAIL=demo@hkcamera.app
DEMO_PASSWORD=
# Note: if ADMIN_PASSWORD or DEMO_PASSWORD are empty, a random 16-char
# password is generated and printed at seed time.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hkcamera.app

STORAGE_STRATEGY=local
LOCAL_UPLOAD_DIR=./uploads
LOCAL_RECORDING_DIR=./recordings

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── TURN server (choose one) ───────────────────────────────────
# Option A: Self-hosted Coturn
# COTURN_REALM=yourdomain.com
# COTURN_SERVER=turn.yourdomain.com
# COTURN_PORT=3478
# COTURN_SECRET=your-coturn-static-auth-secret
#
# Option B: Cloudflare TURN
# CLOUDFLARE_TURN_TOKEN_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# CLOUDFLARE_TURN_TTL=86400
