NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://hk:secret@localhost:5432/hkdb
REDIS_URL=redis://localhost:6379

JWT_SECRET=supersecretjwtkey_changeme
JWT_REFRESH_SECRET=supersecretrefreshkey_changeme
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=hk-camera-recordings

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=noreply@hkcamera.app

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hkcamera.app

STORAGE_STRATEGY=local
LOCAL_UPLOAD_DIR=./uploads
LOCAL_RECORDING_DIR=./recordings

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
