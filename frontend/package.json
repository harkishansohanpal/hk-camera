{
  "name": "hk-camera-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .jsx,.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=true playwright test",
    "test:smoke": "playwright test e2e/smoke.spec.js",
    "test:regression": "playwright test e2e/regression.spec.js",
    "test:stress": "playwright test e2e/stress/ --timeout=3600000",
    "test:stress:long": "STRESS_DURATION=600000 playwright test e2e/stress/long-duration.spec.js --timeout=7200000",
    "test:stress:reconnect": "playwright test e2e/stress/reconnect.spec.js --timeout=600000",
    "test:stress:multi": "playwright test e2e/stress/multi-viewer.spec.js --timeout=600000",
    "test:stress:network": "playwright test e2e/stress/network-fault.spec.js --timeout=600000"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.3",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.2",
    "canvas": "^3.2.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "vitest": "^4.1.9"
  }
}
