# ─────────────────────────────────────────
#  HK Camera – Root Environment Example
#  Copy to .env and fill in real values
# ─────────────────────────────────────────

# ── App ──────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────
DATABASE_URL=postgresql://hk:secret@localhost:5432/hkdb

# ── JWT ──────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AWS S3 (cloud recordings) ─────────────
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
S3_BUCKET=hk-camera-recordings

# ── Email (SMTP) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
ALERT_FROM=noreply@hkcamera.app

# ── Web Push (VAPID) ─────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your@email.com

# ── Storage Strategy ─────────────────────
# Options: local | s3
STORAGE_STRATEGY=local
LOCAL_UPLOAD_DIR=./uploads
LOCAL_RECORDING_DIR=./recordings

# ── Rate Limiting ─────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Stripe ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Coturn TURN Server ────────────────────
# Required for WebRTC behind symmetric NATs
COTURN_REALM=yourdomain.com
COTURN_SECRET=your_coturn_static_auth_secret
COTURN_EXTERNAL_IP=your_server_public_ip
# Optional: coturn container hostname (default: coturn)
# COTURN_SERVER=turn.yourdomain.com
# COTURN_PORT=3478

# Alternative: Cloudflare TURN (instead of Coturn)
# CLOUDFLARE_TURN_TOKEN_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# CLOUDFLARE_TURN_TTL=86400

# ── Seed / Demo Account ────────────────────
# Passwords are NEVER stored in the repo.
# Set via env vars; if left blank, random ones are generated at seed time.
# ADMIN_EMAIL=admin@hkcamera.app
# ADMIN_PASSWORD=
# SEED_DEMO=true
# DEMO_EMAIL=demo@hkcamera.app
# DEMO_PASSWORD=
